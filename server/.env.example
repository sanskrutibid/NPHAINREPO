# Copy to .env and fill in. Use the SMTP details of the mailbox that sends the mail (for example the Hostinger email hr@phianinfotec.com).
PORT=3000
MAIL_TO=hr@phianinfotec.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# SMTP_SECURE=true   (true for port 465, false for port 587; leave out to choose automatically)
SMTP_USER=hr@phianinfotec.com
SMTP_PASS=your-email-password
